# Берем готовую версию Python 3.10 (slim означает, что она занимает меньше места)
FROM python:3.10-slim

# Создаем папку /app внутри контейнера, где будет лежать наш код
WORKDIR /app

# Копируем все наши файлы (main и index) с компьютера в эту папку
COPY . .

# Команда, которая запустит наш код, когда контейнер включится
CMD ["python", "main.py"]

